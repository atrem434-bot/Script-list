local function corner(o,r)
    local x=Instance.new("UICorner")
    x.CornerRadius=UDim.new(0,r or 9)
    x.Parent=o
    return x
end

local function stroke(o,c,t,tr)
    local x=Instance.new("UIStroke")
    x.Color=c
    x.Thickness=t or 1
    x.Transparency=tr or 0
    x.Parent=o
    return x
end

local function styleButton(b)
    b.AutoButtonColor=false
    b.BackgroundColor3=C.button
    b.TextColor3=C.text
    b.Font=Enum.Font.GothamMedium
    b.TextSize=13
    corner(b,8)
    local s=stroke(b,C.red,1,.7)

    b.MouseEnter:Connect(function()
        TweenService:Create(b,TweenInfo.new(.12),{BackgroundColor3=C.hover}):Play()
        TweenService:Create(s,TweenInfo.new(.12),{Transparency=.15}):Play()
    end)

    b.MouseLeave:Connect(function()
        if b.Parent then
            TweenService:Create(b,TweenInfo.new(.12),{BackgroundColor3=C.button}):Play()
            TweenService:Create(s,TweenInfo.new(.12),{Transparency=.7}):Play()
        end
    end)
    return s
end

