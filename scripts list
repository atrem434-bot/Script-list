        s.Color=C.yellow
        icon.Text="⏳"
        status.Text="Загрузка скрипта..."
        status.TextColor3=C.yellow

        task.spawn(function()
            local ok,err=pcall(function()
                local code=game:HttpGet(data.url)
                local func,compileError=loadstring(code)
                if not func then error(compileError) end
                func()
            end)

            if ok then
                icon.Text="✓"
                status.Text="Скрипт успешно запущен"
                status.TextColor3=C.green
                b.BackgroundColor3=Color3.fromRGB(18,45,27)
                s.Color=C.green

                task.wait(1.5)

                if b.Parent then
                    icon.Text="▶"
                    status.Text="Нажми для запуска"
                    status.TextColor3=C.muted
                    b.BackgroundColor3=C.button
                    s.Color=C.red
                    b.Active=true
                end
            else
